    },
    {
      "id": "FEAT-extras",
      "title": "Home 부가 모듈 - 오늘의 질문 / 생각 일기 / 연결 히스토리",
      "description": "오늘의 질문(사용자 메타 질문 입력), 생각 일기(캘린더 + 날짜별 dot), 연결 히스토리(연결 생성 순서 타임라인).",
      "requirementIds": ["REQ-13"],
      "parentId": "FEAT-home"
    },
    {
      "id": "FEAT-signals",
      "title": "Signals - AI 응집기 / 사고 거울",
      "description": "반복 키워드 빈도, cluster graph, 자연어 흐름 요약(1-2문장), 느슨한 연결 제안, 사고 리듬 분석. 닫기 가능. 강제 답 없음.",
      "requirementIds": ["REQ-5", "REQ-7"],
      "parentId": null
    },
    {
      "id": "FEAT-ai-pipeline",
      "title": "AI 파이프라인 - 임베딩 + 요약 + 연결 점수",
      "description": "캡처 → contentHash → opt-in 큐 → 백엔드 proxy → OpenAI embedding(1024d) → IDB 저장 → KNN 재계산. 요약은 Claude Haiku 4.5. 5초 debounce, 32개 batch. 연결 score = cos × temporal_decay × user_signal, 임계값 0.78.",
      "requirementIds": ["REQ-5", "REQ-7", "REQ-10"],
      "parentId": "FEAT-signals"
    },
    {
      "id": "FEAT-privacy",
      "title": "AI 데이터 프라이버시 - aiOptOut + 투명한 데이터 흐름",
      "description": "메모 단위 aiOptOut 플래그. AI 호출 직전 UI에 분석 대상 메모 개수+샘플 노출. 백엔드 로그는 본문 제외. 외부 API 응답 저장 안 함(pass-through).",
      "requirementIds": ["REQ-10"],
      "parentId": "FEAT-ai-pipeline"
    },
    {
